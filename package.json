{
  "name": "jam-fokus",
  "version": "1.0.3",
  "description": "Jam analog dengan pengatur waktu fokus dan daftar tugas",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/*.test.js\"",
    "build": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "xyz.levia.jamfokus",
    "productName": "Jam Fokus",
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "library-service.js",
      "mini.html",
      "mini-preload.js",
      "index.html",
      "icon.png",
      "shared/**/*.js",
      "renderer/**/*.js",
      "renderer/**/*.css",
      "renderer/fonts/*.woff2"
    ],
    "win": {
      "target": "portable",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Jam Fokus",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Jam Fokus Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "Jam Fokus Portable ${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "FendrixAi",
        "repo": "Plev"
      }
    ]
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "author": "Iqbal Rafi",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
