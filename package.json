{
  "name": "jam-fokus",
  "version": "1.0.0",
  "description": "Jam dinding analog + task timer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/*.test.js\"",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "xyz.levia.jamfokus",
    "productName": "Jam Fokus",
    "files": [
      "main.js",
      "preload.js",
      "mini.html",
      "mini-preload.js",
      "index.html",
      "icon.png",
      "shared/**/*.js",
      "renderer/**/*.js",
      "renderer/**/*.css"
    ],
    "win": {
      "target": "portable",
      "icon": "icon.png"
    }
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  }
}